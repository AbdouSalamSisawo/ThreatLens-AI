# ThreatLens AI - frontend environment (Vite)
# Copy to .env, fill in, then REBUILD the frontend
# (Vite compiles these values into the browser bundle at build time).
#
# Both values are PUBLIC by design: the publishable key is safe to ship in
# client-side code. NEVER put a secret/service-role key in this file - the
# browser bundle is public. See README section 8.5.

# Supabase project URL (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase publishable (anon) key - public by design
VITE_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
