# ThreatLens AI - backend environment configuration
# Copy to backend/.env and adjust. All values have safe defaults.

ENVIRONMENT=development

# Comma-separated allowed CORS origins (restrict in production!)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Supabase (required for authentication and Supabase history mode) ---
# Project URL and PUBLISHABLE (anon) key only. The publishable key is meant
# for public clients. NEVER put a service-role/secret key in this backend.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<your-publishable-anon-key>
# Token verification: auto (JWKS when available, else Auth /user endpoint) |
# jwks | userinfo
SUPABASE_AUTH_MODE=auto
# Comma-separated audience allowlist for access tokens (default: authenticated)
SUPABASE_JWT_AUDIENCES=authenticated

# --- Scan history policy: disabled | memory | sqlite | supabase ---
#   disabled : never store scans (maximum privacy)
#   memory   : keep scans in RAM only, cleared on restart
#   sqlite   : persist to the local database file below (dev prototype only)
#   supabase : Supabase Postgres via the Data API; every query carries the
#              caller's verified JWT so RLS policies enforce ownership.
#              Requires the SQL migration in supabase/migrations/ to be applied.
HISTORY_MODE=supabase
DATABASE_PATH=./data/threatlens.db
HISTORY_RETENTION_LIMIT=500

# Input limits
MAX_URL_LENGTH=2048

# Rate limiting (requests per minute per client, in-process)
RATE_LIMIT_SCAN_PER_MINUTE=30

# Optional integrations - the core scanner never requires these.
# No reputation provider is integrated in this prototype.
REPUTATION_PROVIDERS=
